# ==============================================================================
# Database Configuration Template
# Copy this file to '.env' and update with your local/cloud database credentials.
# IMPORTANT: Never commit '.env' containing real secrets to version control.
# ==============================================================================

DB_USER=postgres
DB_PASS=your_secure_password_here
DB_HOST=localhost
DB_PORT=5432
DB_NAME=placement_db

# Optional: Full Database Connection URI (takes precedence over individual variables)
# DATABASE_URL=postgresql+psycopg2://postgres:your_secure_password_here@localhost:5432/placement_db
